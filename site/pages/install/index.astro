---
import Layout from '../../layouts/Layout.astro';
import InstallerShell from '../../components/InstallerShell.astro';
---

<Layout
  title="Set up your device"
  description="Install a new OpenAthan device or recover Wi-Fi and your device password over USB."
>
  <section class="page-heading wrap">
    <p class="eyebrow">OPENATHAN / DEVICE SETUP</p><h1>
      A little setup.<br class="mobile-break" /> A daily connection.
    </h1><p>Connect your speaker, make it yours, and let it take care of the call.</p>
  </section>
  <div class="wrap">
    <InstallerShell /><div class="under-installer">
      <span>AtomS3R C126 + Pyramid A167</span><span>USB setup: desktop Chrome or Edge</span><a
        href="/guides/recovery/">Connection trouble?</a
      >
    </div>{
      import.meta.env.DEV && (
        <div class="preview-link">
          <>
            <strong>Review the preview</strong>
            <p>
              Try installation and recovery with a simulated device. No USB access or firmware files
              are used.
            </p>
            <a href="/preview/installer/">
              Open the interactive simulator <span aria-hidden="true">↗</span>
            </a>
          </>
        </div>
      )
    }
  </div>
</Layout>
<script>
  import '../../../installer/entry';
</script>
