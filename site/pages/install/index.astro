---
import Layout from '../../layouts/Layout.astro';
import InstallerShell from '../../components/InstallerShell.astro';
import { siteSelection } from '../../release-selection';
const selection = await siteSelection();
---

<Layout
  title="Set up your device"
  description="Install OpenAthan or recover Wi-Fi and your device password over USB on AtomS3R C126 + Pyramid A167."
>
  <section class="page-heading wrap">
    <h1>Set up OpenAthan</h1><p>
      Install OpenAthan or fix Wi-Fi and your device password over USB.
    </p>
  </section>
  <div class="wrap">
    <InstallerShell catalog={selection} /><div class="under-installer">
      <span>AtomS3R C126 + Pyramid A167</span><span>USB setup: desktop Chrome or Edge</span><a
        href="/docs/troubleshooting/">Connection trouble?</a
      >
    </div>{
      import.meta.env.DEV && (
        <div class="preview-link">
          <>
            <strong>Installer simulator</strong>
            <p>
              Try installation and recovery with a simulated device. No USB access or firmware files
              are used.
            </p>
            <a href="/preview/installer/">Open the interactive simulator</a>
          </>
        </div>
      )
    }
  </div>
</Layout>
<script>
  import '../../../installer/entry';
</script>
