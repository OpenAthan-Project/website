---
import Layout from '../layouts/Layout.astro';
import CableDiagram from '../components/CableDiagram.astro';
---

<Layout title="Standalone Athan speaker software">
  <section class="hero wrap">
    <div class="hero-copy">
      <p class="eyebrow">OPENATHAN</p><h1>Open-source software for a standalone Athan speaker</h1><p
        class="lede"
      >
        Build an Athan speaker with separately purchased M5Stack hardware. OpenAthan calculates
        prayer times locally and plays recordings stored on your device.
      </p><div class="actions">
        <a class="button" href="/docs/getting-started/">Getting started</a><a
          class="text-link"
          href="https://github.com/OpenAthan-Project/openathan">View on GitHub</a
        >
      </div><aside class="notice release-note">
        <strong>In development — first-time installation is not available yet.</strong>
        <p>USB recovery is available for compatible OpenAthan devices.</p>
      </aside><a class="text-link" href="/install/">Fix Wi-Fi or password</a>
    </div>
    <div class="hero-art" aria-hidden="true">
      <div class="art-orbit orbit-one"></div><div class="art-orbit orbit-two"></div><div
        class="arch-art"
      >
        <svg viewBox="0 0 180 110" aria-hidden="true"
          ><path
            d="M15 55h14m12-13v26m13-40v54m13-54v54m13-68v82m13-59v36m13-45v54m13-67v80m13-67v54m13-40v26m13-20v14"
            fill="none"
            stroke="currentColor"
            stroke-width="4"
            stroke-linecap="round"></path></svg
        >
      </div>
    </div>
  </section>
  <section class="principles wrap" aria-label="OpenAthan features">
    <article>
      <h2>Standalone operation</h2><p>
        Your speaker keeps its settings and plays stored recordings without this website or Home
        Assistant.
      </p>
    </article><article>
      <h2>Local prayer settings</h2><p>
        Choose your location, calculation method, prayer offsets and volume from the device’s local
        page.
      </p>
    </article><article>
      <h2>Open-source software</h2><p>
        Read the source, report an issue, or contribute code and documentation on GitHub.
      </p>
    </article>
  </section>
  <section class="home-hardware wrap" aria-labelledby="supported-hardware">
    <div>
      <h2 id="supported-hardware">Supported hardware</h2><p>
        The reference build pairs an <a href="https://docs.m5stack.com/en/core/AtomS3R"
          >M5Stack AtomS3R C126</a
        >{' '}
        with the <a href="https://docs.m5stack.com/en/atom/Echo_Pyramid"
          >Pyramid A167 speaker base</a
        >. Purchase these modules separately. No soldering or separate home server is needed.
      </p>
    </div><a class="docs-card" href="/docs/getting-started/"
      ><span class="eyebrow">DOCUMENTATION</span><strong>Setup instructions</strong><span
        >Hardware requirements, USB connections, and device settings</span
      ></a
    >
    <CableDiagram />
  </section>
</Layout>
