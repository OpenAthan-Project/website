---
import '../styles.css';
interface Props {
  to: string;
  title: string;
}
const { to, title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="refresh" content={`0;url=${to}`} />
    <link rel="canonical" href={new URL(to, Astro.site)} />
    <title>{title} · OpenAthan</title>
  </head>
  <body>
    <main class="docs wrap">
      <h1>This page has moved</h1>
      <p>Continue to <a href={to}>{title}</a>.</p>
    </main>
  </body>
</html>
