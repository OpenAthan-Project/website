---
import '../styles.css';
interface Props {
  title: string;
  description?: string;
  preview?: boolean;
}
const {
  title,
  description = 'Open-source software for standalone Athan devices, designed to adapt to different hardware. Local prayer calculations and stored Athan recordings.',
  preview = false,
} = Astro.props;
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="referrer" content="no-referrer" />
    {preview && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#163f36" />
    <title>{title} · OpenAthan</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header wrap">
      <a class="brand" href="/" aria-label="OpenAthan home"
        ><svg width="28" height="32" viewBox="0 0 28 32" fill="none" aria-hidden="true"
          ><path
            d="M3 29V15C3 8 9 4 14 2c5 2 11 6 11 13v14M9 29V16c0-4 2-6 5-8 3 2 5 4 5 8v13"
            stroke="currentColor"
            stroke-width="2"></path><path d="M1 30h26" stroke="currentColor" stroke-width="2"
          ></path></svg
        ><span>OpenAthan</span></a
      >
      <nav aria-label="Main navigation">
        <a
          href="/docs/"
          aria-current={path === '/docs/'
            ? 'page'
            : path.startsWith('/docs/')
              ? 'location'
              : undefined}>Documentation</a
        ><a href="https://github.com/OpenAthan-Project/openathan">GitHub</a><a
          class="nav-cta"
          href="/install/"
          aria-current={path === '/install/' ? 'page' : undefined}>USB setup</a
        >
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer wrap">
      <div>
        <a class="footer-brand" href="/">OpenAthan</a><p>
          Open-source Athan software · In development
        </p>
      </div><div class="footer-links">
        <a href="/docs/#contributing">Contributing</a><a href="/docs/#report-an-issue"
          >Report an issue</a
        ><a href="/docs/#licenses">License</a><a href="https://github.com/OpenAthan-Project/website"
          >Website source</a
        ><a href="/third-party-notices.txt">Third-party notices</a>
      </div>
    </footer>
  </body>
</html>
